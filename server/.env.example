# Our backend server's env. Copy to server/.env (gitignored) for local dev.
# In production, Railway holds these.

# Port. Local dev uses 3000 (sort-bot-api owns 8080). Railway provides PORT.
PORT=3000

# Where to find sort-bot-api.
# Local dev (sort-bot-api running via docker-compose): http://localhost:8080
# Production: https://sort-bot-api-production.up.railway.app
SORT_BOT_API_URL=https://sort-bot-api-production.up.railway.app

# Turso (libSQL) connection. Get via `turso db show <name> --url`.
DATABASE_URL=libsql://...
DATABASE_AUTH_TOKEN=

# Session signing. Random 64-char string. Different per env.
SESSION_SECRET=

# Persona generation
LEONARDO_API_KEY=
ANTHROPIC_API_KEY=

# Always-on listener for sort-bot-api's global SSE feed (deferred — see
# debt.md D-8). Leave false until the listener ships.
RUN_LISTENER=false

# Comma-separated origins permitted by CORS.
# Local dev: http://localhost:5173
# Production: https://sort-bot-arena.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,https://sort-bot-arena.vercel.app

LOG_LEVEL=info

# Sentry (optional). Without SENTRY_DSN, sentry init is a silent no-op.
# Cookies, Authorization, and api-key headers are redacted in beforeSend.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
