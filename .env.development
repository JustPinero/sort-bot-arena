# Frontend dev mode — `pnpm dev`.
#
# Default: target the local instance of our backend server at port 3000.
# Override with .env.local for individual workflows:
#   - `VITE_USE_MOCKS=true` — MSW intercepts all /api/v1/* in the browser.
#                            Use when our server isn't running.
#   - `VITE_API_BASE_URL=https://sort-bot-arena-server-production.up.railway.app`
#                          — point dev frontend at the deployed backend.
VITE_API_BASE_URL=http://localhost:3000
VITE_USE_MOCKS=false
VITE_ENABLE_VISUAL_REGRESSION=true
