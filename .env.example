# sort-bot-api base URL. REQUIRED — src/api/client.ts throws at module load if unset.
VITE_API_BASE_URL=http://localhost:8080

# Prefix for auto-generated guest names (e.g., "anonymous-otter-4729").
VITE_GUEST_NAME_PREFIX=anonymous-

# Start with audio toggle on by default. Almost always false; mostly for dev.
VITE_ENABLE_AUDIO_BY_DEFAULT=false

# Enables /dev/design-system route and Playwright visual-regression suites.
VITE_ENABLE_VISUAL_REGRESSION=false

# Enables MSW handlers in the browser (dev only). Tests always use MSW.
VITE_USE_MOCKS=false
