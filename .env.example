# Frontend env. Copy to .env.local for individual overrides.
# Vite picks the right file by mode:
#   - `pnpm dev`   → .env.development
#   - `pnpm build` → .env.production
# .env.local always wins; .env.<mode>.local wins per mode. All but
# .env.example are gitignored.

# Where the frontend looks for the backend API.
# Dev default:  http://localhost:3000  (our local server)
# Prod default: https://sort-bot-arena-server-production.up.railway.app
VITE_API_BASE_URL=http://localhost:3000

# Enables MSW browser handlers in place of real network calls.
# Use when developing without our server running, or to demo a
# Vercel preview without a live backend.
VITE_USE_MOCKS=false

# Enables /dev/design-system route + Playwright visual-regression mode.
VITE_ENABLE_VISUAL_REGRESSION=false

# Default-on the audio toggle. Almost always false; mostly for dev.
VITE_ENABLE_AUDIO_BY_DEFAULT=false

# Sentry (optional). Without VITE_SENTRY_DSN, sentry init is a silent
# no-op. Cookie / Authorization / api-key headers and storage keys
# are redacted in beforeSend; console-arg breadcrumbs are dropped.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
